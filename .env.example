PORT=3000
NODE_ENV=development

# Tipo de persistencia: memory o sequelize
PERSISTENCE_TYPE=memory

# Ruta del archivo SQLite (usado cuando PERSISTENCE_TYPE=sequelize)
SQLITE_PATH=./database.sqlite

# Tipo de notificador de eventos: console, file o both
NOTIFIER_TYPE=console

# Ruta del archivo de logs para el notificador (cuando NOTIFIER_TYPE=file o both)
NOTIFIER_FILE_PATH=./logs/eventos.log
